# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# Runtime state (event logs / blob stores are per-run, git-native saves are explicit)
/runs/
.deepreason/
*.local.yaml

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Transient validation-study checkpoint (durable output is validation_report.json)
experiments/results/validation_checkpoint*.json

# Live-rig credential env files (never committed)
experiments/live_tri_2026-07-27/env
experiments/live_compare_2026-07-28/env
experiments/live_research_2026-07-29/env
experiments/live_jolt_2026-07-31/probe.env
experiments/2026-08-04-change-rung5-dumb-alternative-backend/env
# Rung 5 A/B transient run output (the AUDIT json is the committed evidence)
experiments/2026-08-04-change-rung5-dumb-alternative-backend/qualify.err
experiments/2026-08-04-change-rung5-dumb-alternative-backend/*-reason.err
experiments/2026-08-04-change-rung5-dumb-alternative-backend/ab_driver.log

# Subagent git worktrees. Created by Workflow isolation: 'worktree' and removed
# when the agent finishes; committing one would commit a second checkout of the
# repository into itself.
.claude/worktrees/
.docs_verify_cache.json
experiments/*/env

# Large experiment outputs (keep manifests, but ignore transient runs)
experiments/*/home/
experiments/*/.deepreason/
experiments/*/qualification-cache/

# Build and wheel outputs
*.whl
