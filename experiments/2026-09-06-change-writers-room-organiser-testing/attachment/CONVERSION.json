  },
  {
   "about": "76f244935b33bbf83db0551188644d263d71a3214f33e938febbbeaa42dae9a7",
   "body_sha256": "cd413352c3377d1b6e14ff7d0cb0a2d7a79e091215ea48d7cb9b37453f6b3b01",
   "chars": 297,
   "cycle": 3,
   "file": "02-proposals.txt",
   "id": "68235e6e2bc905b5ca72acd32c0739af24e8b31b1922e7d25a812fa776e69cd8",
   "kind": "proposal",
   "label": "predicts"
  },
  {
   "about": "a0b919ae506615d2d7594201179ce183589fd29077a754b18dafc5214f197797",
   "body_sha256": "2314c23ad7e4dc3d938062834e5a4f274d7ab29455373214702b1d70d9e425e7",
   "chars": 955,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "a4b4bcf31601654d66933fecfb3bf8b4c86d3b4fadf62e108c3e26ff10615350",
   "kind": "objection",
   "label": "A rigorous demonstration showing how to derive a preference rule from non-inductive premises without assuming any continuity between past test results and future predictive success."
  },
  {
   "about": "a0b919ae506615d2d7594201179ce183589fd29077a754b18dafc5214f197797",
   "body_sha256": "89e184ab589c6ff4c4e3f6e335e3a417ee990d4f0e873e9109d3f0ba2c98d737",
   "chars": 1021,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "b45c7e6e169fd9c48da59d55cd46726d469d757365c82a3f93453e6ffd4e11f3",
   "kind": "objection",
   "label": "An explanation of how 'severity' of a test can be measured and valued without invoking the inductive assumption that passing severe tests makes a theory more likely to pass future tests."
  },
  {
   "about": "a0b919ae506615d2d7594201179ce183589fd29077a754b18dafc5214f197797",
   "body_sha256": "951bd9e4adbc8e074a7b5f4dab0a1d3c383ec59ffad722f8befe63e5f43c8719",
   "chars": 908,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "ba596c8f702dbe38b9eff42ff841c300f7ba5044143e4846ccc41ac7c971112d",
   "kind": "objection",
   "label": "A clear distinction between 'psychological confidence' derived from testing and 'rational justification' for action that does not rely on inductive inference."
  },
  {
   "about": "92968bc0cf42d9652ea12be6542003901e790df25afa74ec9cd14fef2cd65ffd",
   "body_sha256": "59c2c3ac04a76e1cb4d3a9f1f0f52ec2434b4a4b19e4cb7f58108d419b5b1179",
   "chars": 1010,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "de0b18a2cb0949fbb38501aae038aeb54bf7932c6bd1ad3e487800f091f7f28b",
   "kind": "objection",
   "label": "A rigorous demonstration that a coherent, non-probabilistic measure of verisimilitude exists which successfully ranks theories such that higher corroboration strictly implies greater closeness to the truth, without collapsing into inductive probability."
  },
  {
   "about": "92968bc0cf42d9652ea12be6542003901e790df25afa74ec9cd14fef2cd65ffd",
   "body_sha256": "f4d75c6bc6c878f984464cd72e804f05df3144b13fe736d479754d98a8c00dd4",
   "chars": 1038,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "2480052e612f9dc5442180ad8dfe77c9b3a5182d60acfcef53861c01cfaad879",
   "kind": "objection",
   "label": "A deductive proof showing that the survival of a theory under past tests increases its fitness for future tests without invoking any assumption about the stability of natural laws or the resemblance of the future to the past."
  },
  {
   "about": "92968bc0cf42d9652ea12be6542003901e790df25afa74ec9cd14fef2cd65ffd",
   "body_sha256": "ac0d6af81957818b4550dcd91c30a902d515d403c6cbf333a1f3e849ddceceb5",
   "chars": 1033,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "d6821854ab37bdecb146a74cabcc7a2a37426cc0cdcb8462d76c933826a75797",
   "kind": "objection",
   "label": "An account of how a 'regulative ideal' that admits no logical proof can function as a rational basis for theory choice within a framework that defines rationality strictly as adherence to logical deduction and falsification."
  },
  {
   "about": "67873974ceb0d9a148ec85758e48c5b8d855c5a4bbbf7f8b0fd2897ec557f92e",
   "body_sha256": "1a09b9d5f16d1091db85399bf36231307e3038e937140a77caf11b26b978fe22",
   "chars": 799,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "6b97cc064898b8141294adf9a22125c8f67952f6d61c59568252344f8b3edfff",
   "kind": "objection",
   "label": "A definitive textual analysis of Popper's distinction between 'corroboration' (a report on past tests) and 'probability' (a prediction of future success), specifically examining his arguments in 'The Logic of Scientific Discovery' regarding the rationality of acting on unfalsified theories."
  },
  {
   "about": "67873974ceb0d9a148ec85758e48c5b8d855c5a4bbbf7f8b0fd2897ec557f92e",
   "body_sha256": "790112306a26033fe82c80040204770083d565f1061f3172b78ff65a4d7bed2b",
   "chars": 714,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "d41766b7844f9da90908a565337adf9330fdf069a6b908bba7c2c4f7e1538af5",
   "kind": "objection",
   "label": "Clarification on whether 'rational preference' in Popper's framework requires an assumption of the uniformity of nature, or if it relies solely on the logical asymmetry between verification and falsification."
  },
  {
   "about": "67873974ceb0d9a148ec85758e48c5b8d855c5a4bbbf7f8b0fd2897ec557f92e",
   "body_sha256": "2bf1dcb6318f93d896b99222cb8a91d6bf00c1cee299b10ec9a0e04f78b923fa",
   "chars": 674,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "11f838436cbe414c3a475949f93f152578cc3f58e39add7f66bacde23d60018b",
   "kind": "objection",
   "label": "An examination of Popper's specific responses to critics who accused him of cryptic inductivism, particularly his later works where he refines the concept of verisimilitude."
  },
  {
   "about": "e0959a2b912e796cf946820383cadac756231541281c4842450e120b92d3dc24",
   "body_sha256": "8bca9c89d8c8378cddfa51fe4c684c95c400a86881b8f8e0ee7acc4f20d3f543",
   "chars": 932,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "2d5abb2aac97e6de5c1fad44cad68a9715443f2953e6a65abb9b354b2ba90d58",
   "kind": "objection",
   "label": "A demonstration that Popper's criterion for 'severity' can distinguish between theories without relying on any background assumption that past performance correlates with future reliability."
  },
  {
   "about": "e0959a2b912e796cf946820383cadac756231541281c4842450e120b92d3dc24",
   "body_sha256": "44a8880dafda59ac502a0893afaa5c3ccb7a17d23b2701021d0ab4aff62c8453",
   "chars": 1027,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "d810261257facfb4d744023c2b7c91dd8d5acd0c305e3aa4f0d79f98911fa57e",
   "kind": "objection",
   "label": "Evidence from scientific history showing researchers consistently choosing less established, riskier hypotheses over well-corroborated ones solely to accelerate falsification."
  },
  {
   "about": "e0959a2b912e796cf946820383cadac756231541281c4842450e120b92d3dc24",
   "body_sha256": "970c4fe9d1373b4185b290d3211625388864bcd21640f59175563be44aa2367b",
   "chars": 983,
   "cycle": 1,
   "file": "03-objections.txt",
   "id": "854ea2a23699fbd2e9d23a19ff562f4f537eb71780a26cb8578a49e8b9a00073",
   "kind": "objection",
   "label": "A clear articulation of how an engineer can rationally rely on a theory for safety-critical design while simultaneously holding zero belief in its likelihood of being true or applicable to the specific case."
  },
  {
   "about": "da6f74bed07c54a4f0de22cdecdce71da65119ad40ce1aa00214ae8c81c9aeca",
   "body_sha256": "5bf7b177026474920bbd4e3c094528b38543a43bb5573b292595382db308c51a",
   "chars": 953,
   "cycle": 2,
   "file": "03-objections.txt",
   "id": "d09a8079a76a22f24138a5fc0fe19d2655274148648bffbd9283c2887a80d57a",
   "kind": "objection",
   "label": "A demonstration of how a rational agent can consistently prefer Theory A over Theory B for life-critical decisions without assigning any higher subjective expectation of success to Theory A based on its test history."
  },
  {
   "about": "da6f74bed07c54a4f0de22cdecdce71da65119ad40ce1aa00214ae8c81c9aeca",
   "body_sha256": "253ec0e056df37d3b32605250b86e62414c48982b9aa38aa3033809f6d411492",
   "chars": 764,
   "cycle": 2,
   "file": "03-objections.txt",
   "id": "33161462ad1b2b226f1ec65255764a3f96950bda2e5049480b0dc65be3317953",
   "kind": "objection",
   "label": null
  },
  {
   "about": "da6f74bed07c54a4f0de22cdecdce71da65119ad40ce1aa00214ae8c81c9aeca",
   "body_sha256": "65f6d79555816a4f3b080f5514dec9d6088fa76390df125c177328d2f9ff2cf5",
   "chars": 844,
   "cycle": 2,
   "file": "03-objections.txt",
   "id": "a7a10cdf38006e310cbb0afc6df0233d405e938877b3357c890709d7b4aac0c8",
   "kind": "objection",
   "label": "Evidence showing that historically, theories with high corroboration are falsified faster than theories with low or zero corroboration when subjected to further testing."
  },
  {
   "about": "d8dfb83afbb1d0545172b84213c342e3a8711354d412f80ec34c604d1bb4a81a",
   "body_sha256": "e0b7e769f34c974bafce8c9fd205f967919e77c313dc2eef48e5036359aa59b3",
   "chars": 908,
   "cycle": 2,
   "file": "03-objections.txt",
