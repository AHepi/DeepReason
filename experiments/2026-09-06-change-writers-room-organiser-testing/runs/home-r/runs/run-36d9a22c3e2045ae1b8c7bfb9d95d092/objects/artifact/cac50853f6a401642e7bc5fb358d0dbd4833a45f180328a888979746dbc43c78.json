{"data":{"codec":"utf8","content_ref":"inline:The Pragmatic Wager (a0b919ae506615d2) depends on the rejection of inductive probability for its defense; it is refuted if preferring the better-corroborated theory logically entails an assumption that the future will resemble the past, thereby making the 'pragmatic wager' indistinguishable from the inductive principle Popper explicitly rejects.","id":"ba87ac258f15bb9ce85be1bab6e662478f423630f8f364765f5ba6224790a9e0","interface":{"commitments":["hv-floor@2a45b7988522","lineage-ref@0964fe8d9ab4","relation-form@578e42df713e"],"refs":[{"role":"dependence","target":"057a66911bbb2ee70e509198d2d39a224089a769f297e22c4e230b813cc1822a"},{"role":"dependence","target":"12f4e5e50e43f124d83dbf5a729364427dcb4b71998e175d432ab9a64c0cc710"},{"role":"dependence","target":"9993f9796f5b92ef528fa5cbfdd9c57c92467ca2bcdb42ecd19cff284df50588"},{"role":"dependence","target":"e1478cc8cfc00c1bff41b052607ab154d47e6602a1a537a5732816bde4eb0dac"},{"role":"dependence","target":"f0fc6341c6aa04221ab7caf2732f5e7a175e1fa4a70a1e1b76226dc1a021b1ea"}]},"provenance":{"event_seq":647,"role":"conjecturer","school":"school-0"},"warrants":[]},"id":"ba87ac258f15bb9ce85be1bab6e662478f423630f8f364765f5ba6224790a9e0","schema":"artifact"}