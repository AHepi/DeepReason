{"advisory_context_ref":"sha256:cbb184e592cb800eeb7705f8f3d24b36a45c0bb99aa4c2bfdef6b831a3d22fa9","entries":[{"claim":"At formal sequence 583, artifact 8202c1ba90cfa9ab453aa22755e8d0eb07fcff68ae77f4ec8f793f037af66018 had formal status accepted.","claim_class":"recorded_observation","id":"sha256:62f613edb476293a450c5d64a946cc9b40bcd2a1e4054e591638ee28782a43fa","process_observation_refs":["sha256:f7b0850ad969f8ca69c1b7f32cd85f6ab0cf73a9626ffde3087a9112b5262500"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"At formal sequence 583, artifact 573f12461e73d17102ca43f4378a81608fe19eb363b4c2bd5f4fec841f958ca5 had formal status accepted.","claim_class":"recorded_observation","id":"sha256:bda42f3f770bfa434246176e16c8290d84a4248aa5f6cb9a493f4376288047f9","process_observation_refs":["sha256:9eaf5d40e6f4cfcf1d3348f48655005f39e1e88fef37231dff3ea504f69f69f3"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"At formal sequence 583, artifact 6ae7110038621aa0aba62b479d39533a1b3ebd2b24e717b31d4ddf01c8a7d1c3 had formal status accepted.","claim_class":"recorded_observation","id":"sha256:1d9e1ad605b7deaac419356f47512723446c78bcc2133cee2cfb597e7898fbea","process_observation_refs":["sha256:29abbd4edbdd53155515e9c8fb56087a809775f1cf9d6e207c4b042f20da6c79"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"At formal sequence 583, artifact 57b23d28735bdf5aff3f3ab6b794e5535a0e40d66058d06c53a2834cad90cecd had formal status accepted.","claim_class":"recorded_observation","id":"sha256:f9d7ec13fb5749d14bf61a32658d43bed3f92de4dd625fee6264ff25485f5413","process_observation_refs":["sha256:4438473452504808b0522448c0caceeb0eabc3803d05840970bc13bf88f98205"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"At formal sequence 583, artifact a11f299d13bdfd826538e21ccbc7ccf3cbed391345d101a74271ab0d32932497 had formal status accepted.","claim_class":"recorded_observation","id":"sha256:87eded3c10bf926b97f8e7e4eed8a5a2280660862b56a726f303bd39c1fb9520","process_observation_refs":["sha256:47111e193630c3