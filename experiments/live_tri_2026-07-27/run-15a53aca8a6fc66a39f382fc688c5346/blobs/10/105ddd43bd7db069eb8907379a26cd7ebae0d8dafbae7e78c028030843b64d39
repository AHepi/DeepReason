{"advisory_context_ref":"sha256:59fb4ae3b69e2762ed72a3d21e1e53355b147f4e6942fca3702b1577afe9d36e","entries":[{"claim":"At formal sequence 939, artifact d1c3422e3d18993ac034bc5bbd3b90f90d3294847aca130493c4c8c6272330cb had formal status accepted.","claim_class":"recorded_observation","id":"sha256:c8f7a40e40da902e3b08099c8e43a3c76b50096c4980744952c2388aa0fd1645","process_observation_refs":["sha256:b5ff1fdebb148ed23b51fd3c48e101f2a41b337341d31a2b61371699f352e07e"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"At formal sequence 939, artifact 443e8bb18c3aeff752de3b1e1f418b024d40ac06354ed3ec954e1688c23b11b2 had formal status accepted.","claim_class":"recorded_observation","id":"sha256:4562d13b9818b2f545187045dee51cd6662963c4732ccd63d1c4c4ae161787a6","process_observation_refs":["sha256:b5ed3b96a7fa7980f83b1352d0b7103bcc60fd473b639a40a2cca04b962f525a"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"At formal sequence 939, artifact 7b7a8f206495f67ed07749df99d3286ddf4797e45e7f3a283073f0645b0f8395 had formal status accepted.","claim_class":"recorded_observation","id":"sha256:d3199640451008c7687914801983d0c5dd9afec7f01e1fd114d9a54b08a25a10","process_observation_refs":["sha256:f3442317c15280bebd9ac74a979c70e1703a7a78300e780388d3d8c668916ec1"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"At formal sequence 939, artifact 02f430369393fe957bfd5f81ce2a6cf341359f6c5132bd3e77a2b65a0e3e3578 had formal status accepted.","claim_class":"recorded_observation","id":"sha256:8cc940eef528f37f3b07ab04205283f05eb049f3e1438afa507db6cf5fdf44b8","process_observation_refs":["sha256:d0d75a750873666e6726e0fd1f38510a0d75233ea898d4cfc50b04472bc203cb"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"Resumption is safe if and only if the last recorded event in the log is well-formed and complete, and the causal preconditions (program, inputs, model-state checkpoint) are demonstrably unchanged at resumption time. The append-only identity is preserved because new events extend the same causal chain without rewriting any prior event.","claim_class":"surviving_conjecture","formal_artifact_refs":["d1c3422e3d18993ac034bc5bbd3b90f90d3294847aca130493c4c8c6272330cb"],"id":"sha256:e20745041fdf8d3d2447a5f5cbc0f6394c1c2348ee3c87e54a1e21ea59ad659c","schema":"bridge.claim-ledger.entry.v1"},{"claim":"Resumption must be refused whenever token-budget exhaustion interrupts mid-event, because the partial event either has no well-defined identity (cannot be referenced as a causal parent) or must be rewritten to become complete (violating append-only). There is no safe recovery path for mid-event interruption under strict append-only semantics.","claim_class":"surviving_conjecture","formal_artifact_refs":["443e8bb18c3aeff752de3b1e1f418b024d40ac06354ed3ec954e1688c23b11b2"],"id":"sha256:52e44838d9e31c9b8e7b0e3d833da502482a28f9bf3827e64836e1100821f84a","schema":"bridge.claim-ledger.entry.v1"},{"claim":"Append-only identity is never corrupted by resumption per se; corruption only occurs if the resumption re-evaluates or rewrites already-committed events. Therefore resumption is always permissible as long as the continuation starts strictly after the last committed event, regardless of whether the logical reasoning unit was complete.","claim_class":"surviving_conjecture","formal_artifact_refs":["7b7a8f206495f67ed07749df99d3286ddf4797e45e7f3a283073f0645b0f8395"],"id":"sha256:42313f5d1c84cbb8c1f3112e16396abdb42d481ff6a04104ec74023c060938cc","schema":"bridge.claim-ledger.entry.v1"},{"claim":"Resumption is safe only if the system emitted an explicit 'barrier' or 'suspend' event before or at the point of token-budget exhaustion. Without a barrier, even well-formed events may be part of an incomplete logical unit (e.g., a multi-event inference step), and resumption could produce events that semantically depend on context that was never written to the log.","claim_class":"surviving_conjecture","formal_artifact_refs":["02f430369393fe957bfd5f81ce2a6cf341359f6c5132bd3e77a2b65a0e3e3578"],"id":"sha256:71591dcceed8f4a22bedf6c8a8172806926095cf82a4ca8ff6d37bd55c58fae3","schema":"bridge.claim-ledger.entry.v1"},{"claim":"ART_1 and ART_3 present rival criteria for safe resumption: ART_1 requires a well-formed and complete last event plus unchanged causal preconditions, while ART_3 asserts resumption is always permissible after the last committed event regardless of logical completeness.","claim_class":"conflict","conflict_refs":["d1c3422e3d18993ac034bc5bbd3b90f90d3294847aca130493c4c8c6272330cb","7b7a8f206495f67ed07749df99d3286ddf4797e45e7f3a283073f0645b0f8395"],"id":"sha256:737fca868e54eca81c05c34e6b5224c2b9a4ab7f33467d38f290c1540741a18b","schema":"bridge.claim-ledger.entry.v1","source_conflict_refs":["sha256:83ae1a2aa6e0f022e8c11222f6a18e0801223c276b35c2aa6817cc4117766c73"]},{"claim":"ART_1 and ART_4 present rival criteria: ART_1 permits resumption without a barrier given well-formed events and unchanged preconditions, while ART_4 requires an explicit barrier or suspend event for safe resumption.","claim_class":"conflict","conflict_refs":["d1c3422e3d18993ac034bc5bbd3b90f90d3294847aca130493c4c8c6272330cb","02f430369393fe957bfd5f81ce2a6cf341359f6c5132bd3e77a2b65a0e3e3578"],"id":"sha256:02cf0392e50b573affaf8389f410bec8f1c01809c19b7217637e139eaf449967","schema":"bridge.claim-ledger.entry.v1","source_conflict_refs":["sha256:04c713c0da1187976cf16174fa12aecab42c58d77a8facedad45b66a06f09842"]},{"claim":"ART_3 and ART_4 present rival criteria: ART_3 asserts resumption is always permissible after the last committed event regardless of logical completeness, while ART_4 asserts resumption is safe only if an explicit barrier or suspend event was emitted.","claim_class":"conflict","conflict_refs":["7b7a8f206495f67ed07749df99d3286ddf4797e45e7f3a283073f0645b0f8395","02f430369393fe957bfd5f81ce2a6cf341359f6c5132bd3e77a2b65a0e3e3578"],"id":"sha256:8457fdf98717c0f260c4919a3e1604cdb34387cf1e3ae3a289eb8e1540d36867","schema":"bridge.claim-ledger.entry.v1","source_conflict_refs":["sha256:8d8fb4b21c801bfdc1d6919d25780958636a35b79f9fa86c7094f65f0efb67f3"]},{"claim":"ART_2 and ART_3 present rival criteria: ART_2 states there is no safe recovery path for mid-event interruption under strict append-only semantics, while ART_3 asserts resumption is always permissible as long as the continuation starts strictly after the last committed event.","claim_class":"conflict","conflict_refs":["443e8bb18c3aeff752de3b1e1f418b024d40ac06354ed3ec954e1688c23b11b2","7b7a8f206495f67ed07749df99d3286ddf4797e45e7f3a283073f0645b0f8395"],"id":"sha256:dbec7fd32785d6d5568eb46a383dc0c4bde7b8ee3208112db772150556151bf0","schema":"bridge.claim-ledger.entry.v1","source_conflict_refs":["sha256:c0e18c3a14baa6e7fafb40ec010993683e11642ffd0c4b90c0836ee85b9612dd"]},{"claim":"Adjudication between the rival resumption criteria from ART_1, ART_2, ART_3, and ART_4 cannot be determined from the bounded record: no source, evidence, event, trace, or formal observation handles are supplied to establish which criterion is authoritative.","claim_class":"unknown","id":"sha256:7c22a3026e68211bb538b9becd9ee4b735581a62964885b4bb03406f8893f70a","schema":"bridge.claim-ledger.entry.v1"}],"formal_seq":939,"id":"sha256:5837263ba457ea4567a1f2d0f645c97e052707487a9b00256b8dfab8186b05ea","output_target":"answer","problem_ref":"question-2da717017468d2da3c501dd1dc4ce3cd","retrieval_receipt_ref":"sha256:14e2706e31303eaeb9678004ec9591d2d6b80d199ad2680c801481622bded5c2","schema":"bridge.claim-ledger.v1","source_conflicts":[{"conflicting_refs":["d1c3422e3d18993ac034bc5bbd3b90f90d3294847aca130493c4c8c6272330cb","7b7a8f206495f67ed07749df99d3286ddf4797e45e7f3a283073f0645b0f8395"],"id":"sha256:83ae1a2aa6e0f022e8c11222f6a18e0801223c276b35c2aa6817cc4117766c73","schema":"bridge.source-conflict.v1"},{"conflicting_refs":["d1c3422e3d18993ac034bc5bbd3b90f90d3294847aca130493c4c8c6272330cb","02f430369393fe957bfd5f81ce2a6cf341359f6c5132bd3e77a2b65a0e3e3578"],"id":"sha256:04c713c0da1187976cf16174fa12aecab42c58d77a8faceda