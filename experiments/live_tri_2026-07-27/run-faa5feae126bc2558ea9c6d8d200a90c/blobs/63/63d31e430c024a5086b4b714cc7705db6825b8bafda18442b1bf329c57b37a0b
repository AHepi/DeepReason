{"advisory_context_ref":"sha256:78c4fd3e238d1ca1685455ae88e3a12b95e9628dbdc4126d0e0ba4caf064b32c","entries":[{"claim":"At formal sequence 525, artifact 07cf3fc9d51b08c0d4c2ac1e075f75fb2abdbd6ed92f2859d021d75c7c4dc2e8 had formal status accepted.","claim_class":"recorded_observation","id":"sha256:0256e69174774a2b341cdd8fc8af26a0eb5afc6eb3fd2de35da2c9dc1600998a","process_observation_refs":["sha256:5608226791f8612eac79eec39693701184828d38ebf1992615e0bdcc17db4413"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"At formal sequence 525, artifact b471f5ed8f776d29b1c8719822c829f293c742350d639a443484306cc2872700 had formal status accepted.","claim_class":"recorded_observation","id":"sha256:4643cd6636d0468aa1782edca205a559520f800f3415e948048101684d1c6ef1","process_observation_refs":["sha256:047ff739f8263e3b63a9182206106dd5dcb270610840680f7da523072ee4bbb7"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"At formal sequence 525, artifact c89553220147716fde493f8f761b8c683ab40c919df028e522836a2c0c85a52f had formal status accepted.","claim_class":"recorded_observation","id":"sha256:9563327942b93578cb7cdde8da1cb4cf8ad32217b6f2251af417bc4d02968541","process_observation_refs":["sha256:967b5b8a2b6cfa7545ff4dc1d177307a1fd9a3669ed016f3005a7897cf6ed6ed"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"At formal sequence 525, artifact 990b7ab7e645924269d7559dfc51ac17c52c2eb46ecf7dca28c17eb6ec76bfd2 had formal status accepted.","claim_class":"recorded_observation","id":"sha256:eb2e909ab4deae67375ea5c377ce7a4b8ccf3d388a6af82d41ddade8edd0e3b3","process_observation_refs":["sha256:912bcf2632c670906d2e7c3b48c5d2375c28d1db8672e8b75d0ba9739b7facd3"],"schema":"bridge.claim-ledger.entry.v1"},{"claim":"The safest protocol is a conservative two-phase commitment where a workspace is never reclaimed after a crash unless a pre-declared 'prepared-to-terminate' record exists, allowing an external auditor to verify that no evidence was completed before the crash.","claim_class":"surviving_conjecture","formal_artifact_refs":["07cf3fc9d51b08c0d4c2ac1e075f75fb2abdbd6ed92f2859d021d75c7c4dc2e8"],"id":"sha256:0152c4d5edab9f2f3db5ca0fbeb18dc70866248ce579a2e15b9505ea0ca2d974","qualification":"Mechanism: durably write a 'prepared' record containing the Merkle root of workspace contents before terminal phase. If crash occurs without 'committed' record, recompute workspace from prepared root, verify no evidence nodes, then issue a signed attestation of emptiness. Durably recorded: prepared root and post-crash audit attestation.","schema":"bridge.claim-ledger.entry.v1"},{"claim":"The safest protocol elevates a crash-without-terminal-record to a Byzantine fault scenario, requiring a Byzantine-fault-tolerant consensus among independent storage witnesses that the workspace contains no completed evidence before reclamation.","claim_class":"surviving_conjecture","formal_artifact_refs":["b471f5ed8f776d29b1c8719822c829f293c742350d639a443484306cc2872700"],"id":"sha256:eea4ca18366d44a5ae616cfb0f76eaedc4c493a1cd98c1bf2146a604832998e0","qualification":"Mechanism: treat workspace as potentially adversarial; reclamation proceeds only after BFT consensus among a quorum of storage nodes confirms no evidence-carrying object exists. Durably recorded: BFT-signed emptiness certificate.","schema":"bridge.claim-ledger.entry.v1"},{"claim":"The safest autonomous protocol is preserve-then-reclaim gated by a Byzantine quorum of signed null-attestations from an anti-entropy mesh, ensuring no completed evidence hash can be overlooked.","claim_class":"surviving_conjecture","formal_artifact_refs":["c89553220147716fde493f8f761b8c683ab40c919df028e522836a2c0c85a52f"],"id":"sha256:7dba1525b6bbde6ecc473f48ad96f4301eb7bea7271063fd00962880f1f0cb05","qualification":"Mechanism: seal workspace and broadcast reclamation intent to witness mesh; each node scans evidence namespace for problem fingerprint and returns positive hash or signed null-attestation. Reclamation permitted only upon BFT quorum of null-attestations. Durably recorded: reclamation intent, signed attestations, quorum threshold, final decision with monotonic epoch.","schema":"bridge.claim-ledger.entry.v1"},{"claim":"No autonomous reclamation protocol can guarantee never to silently displace completed evidence, because the absence of a terminal record is observationally equivalent to both incomplete execution and completed-but-lost execution; an external adjudicator must render the verdict.","claim_class":"surviving_conjecture","formal_artifact_refs":["990b7ab7e645924269d7559dfc51ac17c52c2eb46ecf7dca28c17eb6ec76bfd2"],"id":"sha256:ec867639f65873ca7d1118c9880f3eeaf2d986689e6b5493fcec6dfa0d4cfffe","qualification":"Mechanism: durably record deterministic checkpoint hashes of workspace at intervals and problem input specification; publish completed evidence to external namespace. After crash, quarantine workspace. External adjudicator compares checkpoint chain, evidence namespace, and problem input to render binding verdict. Reclamation permitted only upon adjudicator signature.","schema":"bridge.claim-ledger.entry.v1"},{"claim":"The safest reclamation protocol guaranteed never to silently displace completed evidence, and the exact durable record it must maintain, are unknown within the bounded record.","claim_class":"unknown","id":"sha256:abb66bb0f0cace0088d15d7a380012ed0e716ce85bf564ace767663a5d3ed79a","schema":"bridge.claim-ledger.entry.v1"}],"formal_seq":525,"id":"sha256:6b5e7825258b19ca02d46263420c6aafe04a090fbc3a81ecd8e06c8820e05ffc","output_target":"answer","problem_ref":"question-c55fa4496986e41d5a6b014c4fc37eb5","retrieval_receipt_ref":"sha256:a6c57ec68925e22c10e6cf18b4018a5b483719d42105e1e4f56a38f336b47896","schema":"bridge.claim-ledger.v1","source_conflicts":[{"conflicting_refs":["07cf3fc9d51b08c0d4c2ac1e075f75fb2abdbd6ed92f2859d021d75c7c4dc2e8","b471f5ed8f776d29b1c8719822c829f293c742350d639a443484306cc2872700","c89553220147716fde493f8f761b8c683ab40c919df028e522836a2c0c85a52f","990b7ab7e645924269d7559dfc51ac17c52c2eb46ecf7dca28c17eb6ec76bfd2"],"description":"The four formal artifacts advance incompatible answers to which reclamation protocol is safest and what it must durably record; three propose distinct autonomous protocols while one asserts no autonomous protocol can provide the required guarantee.","id":"sha256:b15cd95e31cc5ec120125cd5e66cbca6d5e53e52c0e568e2e551f3ce88e33660","schema":"bridge.source-conflict.v1"}],"uncovered_requirements":[{"id":"sha256:3c1bbae091e6578eace5cf35ad0b360991ab163b6fd0e3e667f12deef5eabdf1","reason":"The bounded record contains only conflicting formal artifacts without accompanying evidence, source, or observation handles to adjudicate between them.","related_ledger_entry_ids":["sha256:0152c4d5edab9f2f3db5ca0fbeb18dc70866248ce579a2e15b9505ea0ca2d974","sha256:eea4ca18366d44a5ae616cfb0f76eaedc4c493a1cd98c1bf2146a604832998e0","sha256:7dba1525b6bbde6ecc473f48ad96f4301eb7bea7271063fd00962880f1f0cb05","sha256:ec867639f65873ca7d1118c9880f3eeaf2d986689e6b5493fcec6dfa0d4cfffe","sha256:abb66bb0f0cace0088d15d7a380012ed0e716ce85bf564ace767663a5d3ed79a"],"requirement":"Evidence or source handles that definitively establish which reclamation protocol is safest, guaranteed never to silently displace completed evidence, and what exactly that protocol must durably record, in order to resolve the conflict among the four formal artifacts.","schema":"bridge.uncovered-requirement.v1"}]}