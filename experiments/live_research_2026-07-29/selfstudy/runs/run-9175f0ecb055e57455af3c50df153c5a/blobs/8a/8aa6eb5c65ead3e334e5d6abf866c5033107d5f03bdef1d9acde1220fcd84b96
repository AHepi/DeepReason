      "model_source": "import random\nimport networkx as nx\n\ndef run_simulation(rival_growth_rate, batch_size, target_validity_nodes, num_cycles=100):\n    G = nx.DiGraph()\n    coverage_debt = 0\n    active_rivals = 0\n    retired_rivals = 0\n    \n    for cycle in range(num_cycles):\n        # Generate new rivals\n        for _ in range(rival_growth_rate):\n            rival_id = f\"rival_{cycle}_{_}\"\n            G.add_node(rival_id, type='rival')\n            # Add a validity node for the rival\n            validity_id = f\"val_{cycle}_{_}\"\n            G.add_node(validity_id, type='validity')\n            G.add_edge(rival_id, validity_id)\n            active_rivals += 1\n            \n        # Criticism phase\n        nodes = list(G.nodes(data=True))\n        rivals = [n for n, d in nodes if d['type'] == 'rival']\n        validity_nodes = [n for n, d in nodes if d['type'] == 'validity']\n        \n        targets = validity_nodes if target_validity_nodes else rivals\n        \n        if not targets: continue\n        \n        for _ in range(batch_size):\n            target = random.choice(targets)\n            # If validity node attacked, retire all connected rivals\n            if target in validity_nodes:\n                successors = list(G.successors(target))\n                for s in successors:\n                    if s in rivals:\n                        active_rivals -= 1\n                        retired_rivals += 1\n                G.remove_node(target)\n            # If rival attacked directly, just retire it\n            elif target in rivals:\n                active_rivals -= 1\n                retired_rivals += 1\n                G.remove_node(target)\n                \n        # Coverage debt is unretired rivals generated this cycle\n        coverage_debt += (rival_growth_rate - (retired_rivals / (cycle + 1)))\n        \n    return {\n        'coverage_debt': coverage_debt,\n        'active_rivals': active_rivals,\n        'retired_rivals': retired_rivals\n    }",
