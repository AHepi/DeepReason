{"data":{"body":{"content":"Does RFC 9110 define idempotence over the observable response, over server state, or both? This matters: if idempotence is defined over responses only, the event-log deduplication requirement is a separate, stronger property.","unfinished":"Unresolved question","why_keep_this":"Related advisory scratch: NEW_001"},"body_hash":"sha256:2e9d2492f00d46976199effd18c238c0392c4790ccfdcf1f36646348424fe258","id":"sha256:2e9479b9db5b501af8795a4d28bf245155ca2346d244f5e1ae068a08ee680371","instance":{"run_id":"sha256:5f25d072f10846a9119812cff8df1d80b34742e2cb2e97bcd7b739459205fe87","seq":24},"provenance":{"actor":"llm","formal_artifact_refs":[],"origin":"transactional-scratch-authoring.v1","source_refs":[]},"schema":"scratch.block.v1"},"id":"sha256:2e9479b9db5b501af8795a4d28bf245155ca2346d244f5e1ae068a08ee680371","schema":"scratch-block"}