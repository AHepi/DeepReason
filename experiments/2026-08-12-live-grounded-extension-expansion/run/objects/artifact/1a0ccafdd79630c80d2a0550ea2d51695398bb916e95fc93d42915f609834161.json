{"data":{"codec":"utf8","content_ref":"inline:SRC_013's two-pass warrant filtering abstracts the family of edge-construction enrichments in SRC_004, SRC_005, SRC_008, and SRC_009: each enrichment is a particular choice of which edges survive into the outer graph, and the inner grounded labelling is the generic selector. Refuted if any of those enrichments produces an outer graph that cannot be represented as the warrant-filtered projection of SRC_013 for some inner labelling.","id":"30e9bb7cdf7f735561339004a95c23d2946aa4ed7cf4686bfbb3e5b44c78c789","interface":{"commitments":["hv-floor@2a45b7988522","lineage-ref@aec7eb98e974","relation-form@578e42df713e"],"refs":[{"role":"dependence","target":"07c3398912d45b4a9b8157672eff28042ba4869ae0a8c15bea92c79aa3532b64"},{"role":"dependence","target":"9f8658b0e01e3bbb26471ff384410bd4edc6256b643b1a4385e0051ebff8f31b"},{"role":"dependence","target":"a82bea5b945bd5205c1a11272a3ddf8bfdd103abe7bbda429828f4707b431110"},{"role":"dependence","target":"d98a41dc58d47192ce4409633e875f6ad8e76c989ea29fbde1a14c0926310741"},{"role":"dependence","target":"e58ce0de729a93c62900a201e4e7098b739614b0b6489f75ab872ba01503d111"},{"role":"dependence","target":"e093eb8611ff0d96fc197357178adfbf4e9e7c0ba8471f3c76aa9f21a3aea46a"},{"role":"dependence","target":"73c33e65d29d6ed0e48bbb9ae73e4f604fa2682b6f48690875e28e06210dc660"},{"role":"dependence","target":"f5a262c5a6bd74029c9528d1063e7a6b5d96c4ee2e4753c79d6fed6817d3fa9b"},{"role":"dependence","target":"86232ebf5626efc5d29fb5630b9284af34a93dae63929c770bc111d0c4e4e61a"}]},"provenance":{"event_seq":5086,"role":"conjecturer","school":"school-2"},"warrants":[]},"id":"30e9bb7cdf7f735561339004a95c23d2946aa4ed7cf4686bfbb3e5b44c78c789","schema":"artifact"}