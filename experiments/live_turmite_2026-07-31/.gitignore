# Run outputs and the run home are held out until the ladder returns, so a
# half-written battery or an in-flight reasoning root never enters the record.
# Force-add the results when the ladder prints its end marker:
#   git add -f turmite-qual.json turmite-qual.err turmite-reason.json \
#             turmite-reason.err turmite-audit.json turmite.log
home/
turmite-qual.json
turmite-qual.err
turmite-reason.json
turmite-reason.err
turmite-audit.json
turmite-audit.err
turmite.log
