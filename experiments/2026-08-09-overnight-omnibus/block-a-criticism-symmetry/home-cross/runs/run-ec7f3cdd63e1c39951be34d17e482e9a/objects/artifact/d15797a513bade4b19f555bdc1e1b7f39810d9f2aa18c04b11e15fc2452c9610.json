{"data":{"codec":"utf8","content_ref":"inline:The 'Temporal Mapping' mechanism (SRC_005) abstracts the specific failure triggers mentioned in SRC_003 and SRC_004 into a general class of 'correlated failures'; this abstraction is refuted if failures map to a single timestamp but recover at rates proportional to individual service MTTR, which would decouple the trigger from the recovery phase.","id":"a516968e5478ca9d557859ea8601129d71fd03ed74f04deda6038460b09890db","interface":{"commitments":["hv-floor@2a45b7988522","lineage-ref@19124fe3a4ed","relation-form@578e42df713e"],"refs":[{"role":"dependence","target":"1249ab59487cfda9691703b54c65569d0d4bbbce90198ff5f734c59f26f595b1"},{"role":"dependence","target":"181c9911c9027c10898b5ad7730cf446911631676d110b1a36e06b051d99ab74"},{"role":"dependence","target":"534a3f2d35887ea2502c813a4468d3c262700210c893e5983ff2ccdc62e787d0"},{"role":"dependence","target":"6a960e916f590f6734a9b2fc75c02d71732ddd142d0683afd458597b7d6cb702"},{"role":"dependence","target":"746ed66c1873113c893cb6d2506f60793e875f31629043a61a4cdab326b076a9"}]},"provenance":{"event_seq":1463,"role":"conjecturer","school":"school-3"},"warrants":[]},"id":"a516968e5478ca9d557859ea8601129d71fd03ed74f04deda6038460b09890db","schema":"artifact"}