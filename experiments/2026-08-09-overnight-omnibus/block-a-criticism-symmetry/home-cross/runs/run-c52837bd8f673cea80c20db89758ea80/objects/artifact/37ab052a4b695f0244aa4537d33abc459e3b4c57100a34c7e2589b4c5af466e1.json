{"data":{"codec":"utf8","content_ref":"inline:The 'pivot variable' theory in SRC_005 abstracts the conceptual errors mentioned in SRC_002, proposing that expertise is the ability to weight variables rather than just identify them; this is refuted if a 'weighted checklist' (assigning numerical values to items) allows non-experts to achieve expert-level reliability without domain knowledge.","id":"1aa9edabdc35d7b712458942b30490477a962f4c6347dee9b60d60de0fd56fbc","interface":{"commitments":["hv-floor@2a45b7988522","lineage-ref@49ac5d8f1ce5","relation-form@578e42df713e"],"refs":[{"role":"dependence","target":"099a3bb5ce1903af7536de18a8c4c6a58bb2fef89caec4e8e0119db7fa6b9cf8"},{"role":"dependence","target":"0a07b5048a67c4213e4e113cc978ea24c78a2e1e847b7b43e5b18a021b1dc074"},{"role":"dependence","target":"5d003bb87b08cf8a385a535ef9316fb8941d8abbafdcf3dedf14bb18a2cc8357"},{"role":"dependence","target":"931f8d687b0a0429f9fbecbab00212877d5e59e0651c30c85b2ad88976193bfa"},{"role":"dependence","target":"d36c185071e00b2be48ab692c428ef9c19852ca47861933528f84363962dcf9f"}]},"provenance":{"event_seq":703,"role":"conjecturer","school":"school-3"},"warrants":[]},"id":"1aa9edabdc35d7b712458942b30490477a962f4c6347dee9b60d60de0fd56fbc","schema":"artifact"}