{"data":{"codec":"utf8","content_ref":"inline:The distinction between 'closed-world' and 'open-world' tasks (SRC_005) depends on the 'Resolution Dependency' (SRC_002), as an open-world task is essentially one where the required resolution for a checklist is infinite. This relation is refuted if a finite-resolution checklist can achieve expert-level reliability in an open-world task.","id":"f61a040adeb245f7a0cffa7537879522e6810d74f044aa5c7661d497e5e34d76","interface":{"commitments":["hv-floor@2a45b7988522","lineage-ref@2f23ced33712","relation-form@578e42df713e"],"refs":[{"role":"dependence","target":"061ddfcce3bb3ffed2f2a7c86800c26ffd3157a23afb42be22ef2a631e1e96f6"},{"role":"dependence","target":"085fa305e8743aa2aa4fd7864aaf84ad3be24412ad921033c256c054862b15ab"},{"role":"dependence","target":"9a48a92c11cfbb2f3c48ce78bd982d6fb2b16c6a33b9a2c29704e2e6228cea23"},{"role":"dependence","target":"ad448b09ed71a5d01e6906cfa9dffcf10557237ea0e7e9f0ff237444eb3e7098"},{"role":"dependence","target":"b5481ea7049f707cdf135f6ecc2174875142f7498fd532d572d5ea64cb48ee3f"}]},"provenance":{"event_seq":685,"role":"conjecturer","school":"school-2"},"warrants":[]},"id":"f61a040adeb245f7a0cffa7537879522e6810d74f044aa5c7661d497e5e34d76","schema":"artifact"}